<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Todo App</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-yellow-100 min-h-screen">
  <div class="max-w-3xl mx-auto py-10 px-5">
    <h1 class="text-4xl font-bold text-center text-cyan-600 mb-8">
      Todo List
    </h1>

    <form action="/add" method="POST" class="bg-red-100 p-6 rounded-xl shadow-md space-y-4">
      <input
        type="text"
        name="title"
        placeholder="Enter todo title"
        required
        class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:ring-2 focus:ring-blue-400"
      >

      <textarea
        name="description"
        placeholder="Enter description"
        class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:ring-2 focus:ring-blue-400"
      ></textarea>

      <button
        type="submit"
        class="w-full bg-green-600 hover:bg-blue-700 text-white py-3 rounded-lg transition"
      >
        Add Todo
      </button>
    </form>

    <div class="mt-8 space-y-5">
      <% todos.forEach(todo => { %>
        <div class="bg-yellow-600 p-5 rounded-xl shadow-md">
          <div class="flex justify-between items-start gap-4">
            <div>
              <h2 class="text-2xl font-semibold text-gray-800">
                <%= todo.title %>
              </h2>

              <p class="text-gray-600 mt-2">
                <%= todo.description %>
              </p>
            </div>

            <div>
              <% if (todo.is_completed) { %>
                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium">
                  Completed
                </span>
              <% } else { %>
                <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-medium">
                  Pending
                </span>
              <% } %>
            </div>
          </div>

          <div class="flex gap-3 mt-5">
            <a
              href="/edit/<%= todo.id %>"
              class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg"
            >
              Edit
            </a>

            <form action="/delete/<%= todo.id %>?_method=DELETE" method="POST">
              <button
                type="submit"
                class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg"
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>