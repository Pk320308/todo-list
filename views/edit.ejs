<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Todo</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-cyan-100 min-h-screen">
  <div class="min-h-screen flex justify-center items-center">
   
    <div class="bg-green-100 p-12  rounded-xl shadow-md">
      <h1 class="text-3xl font-bold text-center text-blue-600 mb-6">
        Edit Todo
      </h1>

      <form action="/update/<%= todo.id %>?_method=PUT" method="POST" class="space-y-4">
        <input
          type="text"
          name="title"
          value="<%= todo.title %>"
          required
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:ring-2 focus:ring-blue-400"
        >

        <textarea
          name="description"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:ring-2 focus:ring-blue-400"
        ><%= todo.description %></textarea>

        <label class="flex items-center gap-2 text-gray-700">
          <input
            type="checkbox"
            name="is_completed"
            <%= todo.is_completed ? "checked" : "" %>
          >
          Completed
        </label>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg transition"
        >
          Update Todo
        </button>
      </form>

      <a href="/" class="inline-block mt-5 text-blue-600 hover:underline">
        ← Back
      </a>
    </div>
  </div>
</body>
</html>